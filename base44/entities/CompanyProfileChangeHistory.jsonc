{
  "name": "CompanyProfileChangeHistory",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "field_name": {
      "type": "string"
    },
    "previous_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    },
    "modified_by": {
      "type": "string"
    },
    "modification_date": {
      "type": "string",
      "format": "date-time"
    },
    "change_reason": {
      "type": "string"
    },
    "related_application_reference": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "field_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "user_condition": {
            "role": "contributions_officer"
          }
        },
        {
          "user_condition": {
            "role": "contributions_manager"
          }
        },
        {
          "user_condition": {
            "role": "accounts_unit"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "system_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "system_admin"
      }
    }
  }
}