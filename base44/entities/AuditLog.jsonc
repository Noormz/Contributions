{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "previous_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "related_reference": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "entity_type",
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "user_condition": {
            "role": "contributions_manager"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "system_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "system_admin"
      }
    }
  }
}