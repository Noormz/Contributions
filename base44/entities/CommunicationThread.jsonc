{
  "name": "CommunicationThread",
  "type": "object",
  "properties": {
    "thread_reference": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "assigned_officer_id": {
      "type": "string"
    },
    "assigned_officer_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "awaiting_company",
        "replied",
        "closed",
        "unmatched"
      ],
      "default": "open"
    },
    "last_activity": {
      "type": "string",
      "format": "date-time"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "application_reference": {
      "type": "string"
    }
  },
  "required": [
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.assigned_officer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "user_condition": {
            "role": "contributions_officer"
          }
        },
        {
          "user_condition": {
            "role": "contributions_manager"
          }
        },
        {
          "user_condition": {
            "role": "accounts_unit"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "user_condition": {
            "role": "contributions_officer"
          }
        },
        {
          "user_condition": {
            "role": "contributions_manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "system_admin"
      }
    }
  }
}
