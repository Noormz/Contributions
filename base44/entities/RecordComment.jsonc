{
  "name": "RecordComment",
  "type": "object",
  "properties": {
    "entity_name": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    }
  },
  "required": [
    "entity_name",
    "record_id",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "contributions_officer"
          }
        },
        {
          "user_condition": {
            "role": "contributions_manager"
          }
        },
        {
          "user_condition": {
            "role": "accounts_unit"
          }
        },
        {
          "user_condition": {
            "role": "system_admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "system_admin"
          }
        }
      ]
    }
  }
}