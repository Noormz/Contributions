{
  "name": "ClearanceLetter",
  "type": "object",
  "properties": {
    "clearance_reference": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "clearance_date": {
      "type": "string",
      "format": "date"
    },
    "validity_period": {
      "type": "string"
    },
    "clearance_status": {
      "type": "string",
      "enum": [
        "pending",
        "issued",
        "expired",
        "revoked"
      ],
      "default": "pending"
    },
    "document_attachment": {
      "type": "string"
    },
    "application_reference": {
      "type": "string"
    },
    "uploaded_by": {
      "type": "string"
    },
    "uploaded_by_id": {
      "type": "string"
    },
    "upload_date": {
      "type": "string",
      "format": "date-time"
    },
    "document_type": {
      "type": "string"
    }
  },
  "required": [
    "company_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "user_condition": {
            "role": "contributions_officer"
          }
        },
        {
          "user_condition": {
            "role": "contributions_manager"
          }
        },
        {
          "user_condition": {
            "role": "accounts_unit"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "user_condition": {
            "role": "accounts_unit"
          }
        },
        {
          "user_condition": {
            "role": "contributions_manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "user_condition": {
            "role": "accounts_unit"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "system_admin"
      }
    }
  }
}
