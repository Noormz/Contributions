{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "template_name": {
      "type": "string"
    },
    "template_key": {
      "type": "string"
    },
    "subject_en": {
      "type": "string"
    },
    "subject_ar": {
      "type": "string"
    },
    "body_en": {
      "type": "string"
    },
    "body_ar": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "template_name",
    "template_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "system_admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "system_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "system_admin"
      }
    }
  }
}