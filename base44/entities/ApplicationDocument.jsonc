{
  "name": "ApplicationDocument",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "calculation_working",
        "payment_evidence",
        "additional",
        "other"
      ]
    },
    "payment_method": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "mime": {
      "type": "string"
    },
    "uploaded_by_name": {
      "type": "string"
    },
    "upload_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "category",
    "file_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "user_condition": {
            "role": "contributions_officer"
          }
        },
        {
          "user_condition": {
            "role": "contributions_manager"
          }
        },
        {
          "user_condition": {
            "role": "accounts_unit"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "system_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "system_admin"
          }
        }
      ]
    }
  }
}
