{
  "name": "WorkflowTransition",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "previous_status": {
      "type": "string"
    },
    "new_status": {
      "type": "string"
    },
    "action_by": {
      "type": "string"
    },
    "action_date": {
      "type": "string",
      "format": "date-time"
    },
    "comments": {
      "type": "string"
    }
  },
  "required": [
    "application_id",
    "new_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "user_condition": {
            "role": "contributions_officer"
          }
        },
        {
          "user_condition": {
            "role": "contributions_manager"
          }
        },
        {
          "user_condition": {
            "role": "accounts_unit"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "system_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "system_admin"
      }
    }
  }
}