{
  "name": "MailOutbox",
  "type": "object",
  "properties": {
    "from_address": {
      "type": "string"
    },
    "to_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cc_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bcc_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "html": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "delivery": {
      "type": "string"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time"
    },
    "thread_id": {
      "type": "string"
    },
    "thread_reference": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "user_condition": {
            "role": "contributions_manager"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "system_admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "system_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "system_admin"
      }
    }
  }
}
