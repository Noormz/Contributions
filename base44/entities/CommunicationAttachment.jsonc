{
  "name": "CommunicationAttachment",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "uploaded_date": {
      "type": "string",
      "format": "date-time"
    },
    "company_id": {
      "type": "string"
    }
  },
  "required": [
    "message_id",
    "filename"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "user_condition": {
            "role": "contributions_officer"
          }
        },
        {
          "user_condition": {
            "role": "contributions_manager"
          }
        },
        {
          "user_condition": {
            "role": "accounts_unit"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "system_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "system_admin"
      }
    }
  }
}