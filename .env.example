# Copy to .env (never commit .env). Read by `npm run dev` / `npm start`.

# ---- AI assistant (server/ai) ----
# Without a key the assistant runs offline: it answers from portal data and the FAQ, and cannot draft emails.
# AI_PROVIDER=anthropic            # azure | openai | anthropic | local (default: the first with a key)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# AI_TIMEOUT_MS=45000

# ---- Email ----
# MAIL_FROM=
# INBOUND_ADDRESS=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ---- Public address used in PDF QR codes ----
# APP_URL=
