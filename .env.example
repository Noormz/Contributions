# Copy to .env (never commit .env). Read by `npm run dev` / `npm start`.

# ---- AI assistant (server/ai) ----
# Without a key the assistant runs offline: it answers from portal data and the FAQ, and cannot draft emails.
# AI_PROVIDER=anthropic            # azure | openai | anthropic | local (default: the first with a key)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# AI_TIMEOUT_MS=45000

# ---- Email ----
# MAIL_FROM=
# INBOUND_ADDRESS=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ---- Public address used in PDF QR codes ----
# APP_URL=

# ---- Dynamics 365 / Dataverse (system of record) ----
# Dynamics holds every portal record; this server keeps a local working copy and syncs.
# 1) Entra ID > App registrations > your app > Certificates & secrets > New client secret
# 2) Power Platform admin center > Environment > Settings > Users + permissions > Application users
#    > New app user > pick the app > role "KFAS Portal Integration" (or System Administrator)
# DATAVERSE_URL=https://amek-contributes.crm4.dynamics.com
# DATAVERSE_TENANT_ID=
# DATAVERSE_CLIENT_ID=
# DATAVERSE_CLIENT_SECRET=
# DATAVERSE_SYNC=on               # off = stop syncing (changes are not queued)
# DATAVERSE_PUSH_MS=3000          # how often queued changes are sent
# DATAVERSE_ACTIONS_MS=5000       # how often staff action requests from the Dynamics apps are run
# DATAVERSE_PULL_MS=30000         # how often staff edits (settings, templates, FAQ, users) are pulled
